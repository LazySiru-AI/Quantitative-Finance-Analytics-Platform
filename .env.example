# Copy to `.env` and fill in. `.env` is gitignored; this template is tracked.
# All settings are read by backend/app/config.py under the INVDASH_ prefix.

# --- Personal data source ---------------------------------------------------
# Where the ledger, account manifest, sector labels and Planner board come from (app.datasource):
#   demo   -- an invented demo portfolio is seeded into an empty data/ directory. Start here.
#   local  -- plain files under data/ (what the test suite uses).
#   remote -- the separate data service (github.com/LazySiru-AI/investing-dashboard-db) is the system
#             of record; this app keeps only a disposable replica under the cache directory.
INVDASH_DATA_SOURCE=demo

# Remote mode only. The token is the data service's LEDGER_TOKEN (generate it there with
# `python -m ledger_service token`). Keep the service on loopback or a private network; put TLS in
# front if it is on another host -- the token travels in a header.
# INVDASH_DB_SERVICE_URL=http://127.0.0.1:8020
# INVDASH_DB_SERVICE_TOKEN=
# INVDASH_DB_SERVICE_TIMEOUT_S=30
# INVDASH_DB_SERVICE_POLL_S=2

# --- Authentication ---------------------------------------------------------
# The dashboard requires a login by default (one shared instance for a handful of named users --
# owner, colleagues, UAT personas -- who all see the same data). See docs/AUTH.md.
#
# Users are managed from the CLI, not here:
#   .venv/Scripts/python.exe -m app.auth.cli add-user <name>
# A fresh instance is intentionally LOCKED until the first user is created (auth on + zero users).
#
# Turn auth off for local single-user development where a login screen is only friction:
# INVDASH_AUTH_ENABLED=0
#
# Set to 1 only when a TLS terminator (Caddy, a reverse proxy, Tailscale Serve) sits in front --
# a Secure cookie is never sent over plain HTTP, so leaving this on for a LAN/loopback deployment
# makes every login silently fail. Required before exposing the instance beyond the local network.
# INVDASH_AUTH_COOKIE_SECURE=0
#
# Session lifetimes in days: idle (reset on each use) and absolute (hard cap regardless of use).
# INVDASH_AUTH_SESSION_IDLE_DAYS=14
# INVDASH_AUTH_SESSION_MAX_DAYS=30

# --- Market data ------------------------------------------------------------

# SEC EDGAR's fair-access policy requires a real, reachable contact e-mail in every request's
# User-Agent (app.institutions.edgar, app.market.providers.sec_edgar) -- Yahoo's chart provider
# reuses the same value. The placeholder below is deliberately non-deliverable so SEC 403s a
# deployment that forgets to set it, rather than leaking a real address. Set this to an address
# SEC should actually be able to reach.
INVDASH_CONTACT_EMAIL=set-INVDASH_CONTACT_EMAIL@example.invalid

# FRED (Federal Reserve Economic Data). Free, read-only, public series.
# Register at https://fredaccount.stlouisfed.org/apikeys
#
# Optional, and leaving it blank costs nothing in coverage: the keyless CSV endpoint
# (fred.stlouisfed.org/graph/fredgraph.csv) serves the same full history as the keyed JSON API --
# DGS10 goes back to 1962 either way. The Yahoo proxies (^TNX, CL=F) are for when FRED itself is
# unreachable, not for when this is unset.
INVDASH_FRED_API_KEY=

# --- Paths (optional overrides) ---------------------------------------------
# Defaults are derived from the repo root; set these only to relocate storage.

# INVDASH_DATA_DIR=
# INVDASH_STORE_DIR=
# INVDASH_CACHE_DIR=

# Paper-desk roster. JSON list of agent ids; unset falls back to the code default.
# INVDASH_PAPERDESK_AGENT_IDS=["B-momentum","A-rotation","c07-chop","c14-riskmanaged-wide"]

# --- influencer personas ----------------------------------------------------
# Obsidian-compatible markdown vault the persona feature writes memory into. Personas live under
# <vault>/influencers/<slug>/. Point it at an existing Obsidian vault to edit notes alongside your
# own; defaults to data/vault/.
# INVDASH_VAULT_DIR=

# Per-ingest-job model-spend cap (decimal string) and the max videos one backfill will pull.
# INVDASH_PERSONA_INGEST_CAP_USD=5
# INVDASH_PERSONA_BACKFILL_MAX=50

# Language persona summaries are written in. Source-language quotes are preserved verbatim regardless.
# INVDASH_PERSONA_SUMMARY_LANG=en

# --- notifications (app.notify) ---------------------------------------------
# Delivery is OFF by default. Every event is still appended to data/notify/events.jsonl and served
# by GET /api/notify/events regardless; this flag governs only whether a channel is used.
# See docs/NOTIFY-RUNBOOK.md.
# INVDASH_NOTIFY_ENABLED=1

# Channel: "log" (default, writes to the application log) or "ntfy" (phone push).
# INVDASH_NOTIFY_CHANNEL=log

# ntfy server and topic. On the public server the topic name is the ONLY access control there is --
# anyone who knows it reads every notification. Pick something long and unguessable, never a word.
# INVDASH_NOTIFY_NTFY_URL=https://ntfy.sh
# INVDASH_NOTIFY_NTFY_TOPIC=

# Policy. Lowest severity delivered (attention|notable|fyi); comma-separated kinds to deliver,
# prefix-matched, empty means all; quiet window in America/New_York during which only "attention"
# is delivered, empty means none; and a rolling-hour ceiling that suppresses a looping producer.
# INVDASH_NOTIFY_MIN_SEVERITY=notable
# INVDASH_NOTIFY_KINDS=
# INVDASH_NOTIFY_QUIET_HOURS=22:00-07:00
# INVDASH_NOTIFY_RATE_CAP_PER_HOUR=20

# Read-only bearer for an external poller (a phone shortcut, a cron). Empty disables the path
# entirely. Reaches four GETs and nothing else: /api/notify/events, /api/notify/status,
# /api/manager/changes, /api/manager/briefs/latest.
# INVDASH_NOTIFY_SERVICE_TOKEN=
